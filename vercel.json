{
  "version": 2,
  "framework": "vite",
  "regions": ["gru1"],
  "functions": {
    "api/resolve.ts": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/audio",
      "destination": "/api/media"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
