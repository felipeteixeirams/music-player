{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/resolve.ts": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/streams/:id",
      "destination": "/api/streams/[id]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
