{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/fluxo-global/guard-push.py",
            "if": "Bash(git push *)",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Verificando a regra de push"
          }
        ]
      }
    ]
  }
}
